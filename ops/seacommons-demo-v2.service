[Unit]
Description=SeaCommons v2 isolated public demo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/seacommons/v2/apps/api
EnvironmentFile=/etc/seacommons-demo-v2.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/seacommons/v2/.venv/bin/uvicorn core.api.main:app --host 127.0.0.1 --port 8101
Restart=always
RestartSec=5
MemoryMax=320M
MemorySwapMax=768M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
