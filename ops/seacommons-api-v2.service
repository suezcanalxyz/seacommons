[Unit]
Description=SeaCommons v2 operational API
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/seacommons/v2/apps/api
EnvironmentFile=/etc/seacommons-v2.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/seacommons/v2/.venv/bin/uvicorn core.api.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5
MemoryMax=650M
MemorySwapMax=1536M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
