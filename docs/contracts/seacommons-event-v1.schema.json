{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seacommons.org/schemas/seacommons-event-v1.schema.json",
  "title": "SeaCommons Event v1",
  "type": "object",
  "required": [
    "schema", "id", "hash", "previous_hash", "type", "source", "node",
    "observed_at", "received_at", "expires_at_ms", "visibility", "properties"
  ],
  "properties": {
    "schema": { "const": "seacommons-event-v1" },
    "id": { "type": "string", "minLength": 16 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "type": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "node": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "visibility": { "$ref": "https://seacommons.org/contracts/live-domain-v1.schema.json#/$defs/visibility" },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "geometry": { "$ref": "https://seacommons.org/contracts/live-domain-v1.schema.json#/$defs/public_geometry" },
    "properties": { "type": "object" },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "expires_at_ms": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
