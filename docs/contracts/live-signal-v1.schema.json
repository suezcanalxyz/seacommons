{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seacommons.org/contracts/live-signal-v1.schema.json",
  "title": "SeaCommons public live signal",
  "type": "object",
  "required": ["type", "id", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "id": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": [
        "schema", "id", "type", "kind", "severity", "tier",
        "verification_status", "publication_status", "timestamp_utc"
      ],
      "properties": {
        "schema": { "const": "org.seacommons.live-signal/v1" },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "kind": { "enum": ["distress", "context"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "tier": { "enum": ["operational", "news", "signal"] },
        "verification_status": { "type": "string" },
        "publication_status": { "const": "published" },
        "timestamp_utc": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "maxLength": 255 },
        "text": { "const": "" },
        "source": { "type": "string", "maxLength": 64 },
        "url": { "type": "string" },
        "drift_ready": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
