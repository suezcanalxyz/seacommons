{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seacommons.org/contracts/live-signal-v1.schema.json",
  "title": "SeaCommons public live signal",
  "type": "object",
  "required": ["type", "id", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "id": { "type": "string", "minLength": 1 },
    "geometry": { "$ref": "live-domain-v1.schema.json#/$defs/public_geometry" },
    "properties": {
      "type": "object",
      "required": [
        "schema", "id", "type", "kind", "severity", "tier",
        "verification_status", "publication_status", "source_policy",
        "timestamp_utc", "location_precision"
      ],
      "properties": {
        "schema": { "const": "org.seacommons.live-signal/v1" },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "kind": { "$ref": "live-domain-v1.schema.json#/$defs/live_signal_kind" },
        "severity": { "$ref": "live-domain-v1.schema.json#/$defs/severity" },
        "tier": { "$ref": "live-domain-v1.schema.json#/$defs/intel_tier" },
        "verification_status": { "$ref": "live-domain-v1.schema.json#/$defs/verification_status" },
        "publication_status": { "const": "published" },
        "source_policy": { "$ref": "live-domain-v1.schema.json#/$defs/source_policy" },
        "location_precision": { "$ref": "live-domain-v1.schema.json#/$defs/location_precision" },
        "incident_lifecycle": { "$ref": "live-domain-v1.schema.json#/$defs/incident_lifecycle" },
        "timestamp_utc": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "maxLength": 255 },
        "text": { "const": "" },
        "source": { "type": "string", "maxLength": 64 },
        "url": { "type": "string" },
        "drift_ready": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
