{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seacommons.org/schemas/environment-snapshot-v1.schema.json",
  "title": "SeaCommons environmental forcing snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "generated_at", "observed_at", "origin", "crs", "sources", "frames"],
  "properties": {
    "schema_version": { "const": "environment-snapshot/v1" },
    "snapshot_id": { "type": "string", "minLength": 5, "maxLength": 128 },
    "generated_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "origin": { "$ref": "#/$defs/origin" },
    "crs": { "const": "EPSG:4326" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "product", "retrieved_at", "attribution"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "attribution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "bearing": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speed_m_s", "direction_deg", "direction_convention"],
      "properties": {
        "speed_m_s": { "type": "number", "minimum": 0 },
        "direction_deg": { "$ref": "#/$defs/bearing" },
        "direction_convention": { "enum": ["from", "to"] }
      }
    },
    "waves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["significant_height_m", "period_s", "direction_deg", "direction_convention"],
      "properties": {
        "significant_height_m": { "type": "number", "minimum": 0 },
        "period_s": { "type": "number", "exclusiveMinimum": 0 },
        "direction_deg": { "$ref": "#/$defs/bearing" },
        "direction_convention": { "enum": ["from", "to"] }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_utc", "wind", "current", "waves"],
      "properties": {
        "time_utc": { "type": "string", "format": "date-time" },
        "wind": { "$ref": "#/$defs/vector" },
        "current": { "$ref": "#/$defs/vector" },
        "waves": { "$ref": "#/$defs/waves" }
      }
    }
  }
}
