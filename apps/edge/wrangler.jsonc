{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seacommons-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://live.seacommons.org,https://play.seacommons.org,http://localhost:5173",
    // Backstop only — the Oracle publisher (core/live_edge_publisher.py)
    // sends an explicit removal at the real 7-day lifecycle cutoff
    // (core/intel/lifecycle.py). This TTL just guarantees nothing lingers
    // forever if the publisher ever goes down before sending that signal.
    "LIVE_EVENT_TTL_SECONDS": "691200",
    "NOSTR_BRIDGE_URL": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }
  ]
}
