{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seacommons-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://play.seacommons.org,http://localhost:5173"
  }
}
