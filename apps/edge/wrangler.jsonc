{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seacommons-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://live.seacommons.org,https://play.seacommons.org,http://localhost:5173",
    "LIVE_EVENT_TTL_SECONDS": "21600",
    "NOSTR_BRIDGE_URL": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }
  ]
}
