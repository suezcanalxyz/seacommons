FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY apps/api/requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# Tesseract backs image OCR for map screenshots (Alarm Phone & tracked SAR NGOs
# publish the GPS position as an image, not in tweet text). Without it the
# OCR path silently no-ops. English language data is required (coordinate OCR).
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/core ./core
COPY apps/api/connect ./connect
COPY apps/api/edge ./edge
COPY README.md ./README.md

EXPOSE 8000

CMD ["uvicorn", "core.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
