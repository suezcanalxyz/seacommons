{$PUBLIC_DOMAIN} {
  encode zstd gzip
  reverse_proxy site:80
}

{$WWW_DOMAIN} {
  redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

{$LEGACY_DOMAIN} {
  redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

{$SEACOMMONS_DOMAIN} {
  encode zstd gzip
  reverse_proxy dashboard:3000
}

{$DEMO_DOMAIN} {
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  reverse_proxy demo-dashboard:3000
}

{$DEMO_API_DOMAIN} {
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  request_body { max_size 1MB }
  reverse_proxy demo-api:8000
}

{$API_DOMAIN} {
  encode zstd gzip
  @metrics path /metrics
  respond @metrics 404
  request_body { max_size 10MB }
  reverse_proxy api:8000
}

{$AUTH_DOMAIN} {
  encode zstd gzip
  reverse_proxy keycloak:8080
}
