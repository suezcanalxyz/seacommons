{
  "buildCommand": "cd apps/web && npm run build",
  "installCommand": "cd apps/web && npm install",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://204.216.210.155/api/:path*" },
    { "source": "/health", "destination": "http://204.216.210.155/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_PUBLIC_BASE": "/",
    "VITE_APP_PROFILE": "demo",
    "VITE_AUTH_ENABLED": "false"
  }
}
